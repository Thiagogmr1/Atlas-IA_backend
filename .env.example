# ==============================================================================
# AtlasAI Backend - Arquivo de Exemplo de Configuração (.env.example)
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env no ambiente local:
#    cp .env.example .env  (Linux/macOS) ou Copy-Item .env.example .env (PowerShell)
# 2. Preencha as variáveis com suas credenciais de desenvolvimento local.
# 3. NUNCA envie o arquivo .env para o controle de versão (Git).
# 4. Em produção, utilize o gerenciador de segredos ou variáveis de ambiente
#    da infraestrutura (ex: AWS Secrets Manager, GCP Secret Manager, Vault).
# ==============================================================================

# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_local
DB_NAME=atlas_db

# Segurança e Autenticação JWT
JWT_SECRET=gere_uma_chave_secreta_longa_e_aleatoria_para_o_jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Retenção de conta
ACCOUNT_DELETION_GRACE_DAYS=30

# ==============================================================================
# Configurações do Agente de IA (Gemini API)
#
# AVISO DE SEGURANÇA:
# - A chave GEMINI_API_KEY deve ficar EXCLUSIVAMENTE no backend.
# - NUNCA compartilhe esta chave no frontend, commits ou mensagens públicas.
# - O agente nunca expõe esta chave nem responde solicitações para lê-la.
# ==============================================================================
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
IMAGEN_MODEL=imagen-3.0-generate-002
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
# Nível opcional de thinking para modelos 2.5: low, medium ou high (deixe em branco se não desejar)
GEMINI_THINKING_LEVEL=
# Limite de mensagens recentes no histórico enviado ao modelo
CHAT_HISTORY_LIMIT=40

# ==============================================================================
# Configurações Meta / Instagram Graph API (Instagram Login & Publicação)
#
# AVISO DE SEGURANÇA:
# - META_APP_SECRET e TOKEN_ENCRYPTION_KEY devem ficar estritamente no backend.
# - NUNCA expor no frontend ou enviar ao Gemini.
# ==============================================================================
META_APP_ID=seu_meta_app_id_aqui
META_APP_SECRET=seu_meta_app_secret_aqui
META_API_VERSION=v21.0
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/integrations/instagram/callback
# Chave de criptografia de tokens (32 bytes para AES-256-GCM)
TOKEN_ENCRYPTION_KEY=sua_chave_de_criptografia_de_32_bytes_aqui

